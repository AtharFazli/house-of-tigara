SUPABASE_URL=
SUPABASE_SECRET_KEY=
ORDER_HASH_SECRET=
# Public anon key from Supabase (Project Settings -> API -> Project API keys -> anon).
# This is the key Supabase expects for supabase-js and is safe to expose.
# Used here only on the server to verify admin sessions; access control comes
# from RLS and grants, never from hiding this key.
SUPABASE_ANON_KEY=
